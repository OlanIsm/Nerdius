{
  "name": "nerdungeon-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify:pdf": "node --env-file-if-exists=.env scripts/verify-pdf.ts"
  },
  "dependencies": {
    "@supabase/server": "^1.9.1",
    "@supabase/supabase-js": "2.116.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
